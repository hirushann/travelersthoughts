# MySQL connection for the app's own user, e.g.
# mysql://travelersthoughts:<password>@127.0.0.1:3306/travelersthoughts
DATABASE_URL=

# Public URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://travelersthoughts.com

# Google Analytics 4 measurement ID. Set it only on the live site so staging and local
# visits don't count. Read at build time, so rebuild after changing it.
# NEXT_PUBLIC_GA_ID=G-HVSZERS437

# Dashboard insights (see README → Dashboard insights). All optional.
# Service account key file, as one-line JSON or base64 of the file.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GA4 numeric property ID (not the G- measurement ID).
# GA4_PROPERTY_ID=
# Search Console property: sc-domain:travelersthoughts.com or https://travelersthoughts.com/
# GSC_SITE_URL=
# API key for PageSpeed Insights.
# GOOGLE_API_KEY=

# Where uploaded images are stored. Defaults to ./storage/uploads in the project.
# On a server, set an absolute path outside the app folder and copy the images there
# (they are not in git). Back this folder up.
# UPLOAD_DIR=/var/www/travelersthoughts-uploads

# Only used by the one-time WordPress migration scripts (npm run wp:*).
# WP_URL=https://travelersthoughts.com
